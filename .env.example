# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase project settings → Database → Connection string (use the
# "Transaction" pooler URI; Drizzle/postgres.js talk to it directly)
DATABASE_URL=

# console.anthropic.com → API Keys. Powers Prime Coach (lib/coach/generate.ts,
# model claude-opus-5). Everything else in the app works without this — the
# deterministic Weekly Review never depends on it.
ANTHROPIC_API_KEY=

# Your own email, exactly as it appears in Supabase → Authentication →
# Users. This app has no per-user data isolation (it's built for exactly
# one person) — set this so that even if a second Supabase account ever
# exists, it's rejected at the door rather than seeing your data. Primary
# control is still disabling public signup in the Supabase dashboard;
# this is the backstop. Safe to leave blank locally.
OWNER_EMAIL=
